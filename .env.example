# Kopieer naar app/.env (staat in .gitignore). Bas maakt het Supabase-project zelf aan; Claude vraagt nooit om sleutels in de chat.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=            # publieke sleutel, mag in de app (RLS beschermt de data)
SUPABASE_SERVICE_ROLE_KEY=    # ALLEEN server-side (tests + edge function), nooit in app/web/
ANTHROPIC_API_KEY=            # ALLEEN server-side, voor de ask-functie
ASK_MODEL=claude-opus-5-5     # instelbaar; controleer het model-id met de claude-api-skill bij fase 4
CHURCHSUITE_FEED_URL=https://hillsongnl.churchsuite.com/embed/calendar/json
